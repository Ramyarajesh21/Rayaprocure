# Copy to .env (project root) and fill in. Never commit the real .env.

# --- Required -----------------------------------------------------------
# Long random value that signs login sessions AND encrypts saved SMTP passwords.
# Changing it later logs everyone out and requires re-entering SMTP passwords.
SECRET_KEY=change-me-to-a-long-random-string

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rayaprocure_db
DB_USER=root
DB_PASSWORD=

# Comma-separated frontend URLs allowed to use the session cookie.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Recommended for production ---------------------------------------------
# Public URL of the frontend. Used in the customer links inside emails (/p/<token>).
PUBLIC_APP_URL=http://localhost:5173
# Send the session cookie only over HTTPS.
SESSION_COOKIE_SECURE=0
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For
# (so the rate limiter sees real client IPs).
TRUST_PROXY_HEADERS=0

# --- Email (optional platform-wide fallback) ------------------------------
# Each company normally saves its own SMTP account in Email & Reminders.
# These are used only for companies that have not configured one.
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_SECURITY=starttls
PLATFORM_SMTP_FROM=
# Emails a single company may send per day.
EMAIL_DAILY_LIMIT=300

# --- Reminders ----------------------------------------------------------------
# 1 = run the daily reminder job inside the API process (single-server setups).
# Otherwise schedule `python run_reminders.py` with cron / Task Scheduler.
REMINDER_SCHEDULER=0
REMINDER_HOUR=9

# Days a customer link stays valid.
SHARE_LINK_DAYS=90
